# 复制成 deploy.env 再修改：cp deploy.env.example deploy.env
# deploy.env 不进 git，以后 git pull 更新代码不会和你的设置冲突。

# 照片根目录（必改）：它下面每个一级子目录是一次出门，里面有 jpg/ 和 raw/
PHOTO_ROOT="/mnt/user/photos"

# 数据库和预览缓存放在这里，建议在 SSD 缓存池上
APPDATA="/mnt/user/appdata/rawpick"

# 浏览器访问端口：http://<Unraid IP>:8080
PORT=8080

# 后台生成预览的线程数
PREVIEW_WORKERS=4

# 以下一般不用改
PUID=99          # nobody
PGID=100         # users
UMASK=000        # 新建的 select/ 和文件对所有人可读写，SMB 上能正常改删
RAW_EXTS=""      # RAW 扩展名白名单，留空用默认：arw,cr2,cr3,nef,raf,dng,orf,rw2
CONTAINER_NAME=rawpick
IMAGE_NAME=rawpick
